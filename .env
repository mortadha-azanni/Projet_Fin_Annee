# ============================================
# PFA Project - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env

# ============================================
# SERVICE URLS (for Gateway Node)
# ============================================
# URLs for internal service communication
SCRAPER_URL=http://scraper:8000
RANKER_URL=http://ranker:8000

# ============================================
# REDIS CONFIGURATION
# ============================================
# Redis cache server
REDIS_HOST=redis
REDIS_PORT=6379
# Redis password (if authentication is enabled)
# REDIS_PASSWORD=your_redis_password_here

# ============================================
# API KEYS
# ============================================
# Google Gemini API Key (for AI/LLM features)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCcIlJ71D1NUQGjTZLdLBc2Jhi-fyhXm5E

# OpenAI API Key (alternative, if using OpenAI)
# OPENAI_API_KEY=AIzaSyCcIlJ71D1NUQGjTZLdLBc2Jhi-fyhXm5E

# ============================================
# SECURITY
# ============================================
# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_generate_a_random_one
# JWT token expiration time (in minutes)
JWT_EXPIRATION_MINUTES=60
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# RATE LIMITING
# ============================================
# Max requests per minute per IP
RATE_LIMIT_PER_MINUTE=60
# Enable rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# ============================================
# DATABASE (if needed in future)
# ============================================
# PostgreSQL connection
# DATABASE_URL=postgresql://user:password@localhost:5432/pfa_db
# MongoDB connection
# MONGODB_URL=mongodb://localhost:27017/pfa_db

# ============================================
# EXTERNAL SERVICES (if needed)
# ============================================
# Proxy service (for scraping behind proxies)
# PROXY_URL=http://proxy-server:port
# PROXY_USERNAME=username
# PROXY_PASSWORD=password

# Webhook URL for notifications
# WEBHOOK_URL=https://your-webhook-endpoint.com

# ============================================
# MONITORING & ANALYTICS
# ============================================
# Sentry DSN for error tracking
# SENTRY_DSN=your_sentry_dsn_here
# Google Analytics tracking ID
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# ============================================
# PORT CONFIGURATION (for local development)
# ============================================
# These are used when running services locally (without Docker)
GATEWAY_PORT=8000
SCRAPER_PORT=8001
RANKER_PORT=8002
REDIS_LOCAL_PORT=6380


# ============================================
# Database Settings
# ============================================
# SupaBase Settings
DB_USER=postgres.rhjqyzssmfwwuksxohov
DB_PASSWORD=MAXinfo2485xd
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=require

# ============================================
# Sentence Transformer & LLM Settings
# ============================================
# Sentence Transformer Settings
MODEL=all-MiniLM-L6-v2
DIMS=384  # all-MiniLM-L6-v2 output dimension

# LLM Gemini Settings
LLM_MODEL=gemini-2.5-flash
API_KEY=AIzaSyCcIlJ71D1NUQGjTZLdLBc2Jhi-fyhXm5E

