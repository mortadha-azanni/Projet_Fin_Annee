# ============================================
# PFA Project - Environment Variables
# ============================================
# This is a default configuration file.
# For production, copy .env.example and customize your values.

# SERVICE URLS
SCRAPER_URL=http://scraper:8000
RANKER_URL=http://ranker:8000

# REDIS CONFIGURATION
REDIS_HOST=redis
REDIS_PORT=6379

# API KEYS - IMPORTANT: Add your actual keys here!
GEMINI_API_KEY=your_gemini_api_key_here

# SCRAPER CONFIGURATION
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY=1

# RANKER CONFIGURATION
RANKING_ALGORITHM=simple
MIN_SCORE_THRESHOLD=0.0
MAX_RESULTS=100

# APPLICATION SETTINGS
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# PORT CONFIGURATION (for local development)
GATEWAY_PORT=8000
SCRAPER_PORT=8001
RANKER_PORT=8002
REDIS_LOCAL_PORT=6380