# ── Required ──────────────────────────────────────────────────────────────────
# Both of these MUST be set. The app will refuse to start without them.

# Min 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

DB_PASSWORD=your_postgres_password

# ── Optional (defaults shown) ─────────────────────────────────────────────────

PROJECT_NAME=Gateway Node
VERSION=0.1.0
DEBUG=false

# Downstream microservices
SCRAPER_URL=http://localhost:8001
RANKER_URL=http://localhost:8002
BRAIN_URL=http://brain:8001

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_SSL=prefer

# Redis (declared for future use)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
